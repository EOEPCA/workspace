// Render: dot -Tsvg package-flow.dot -o package-flow.svg
digraph package_flow {
    graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.4, ranksep=0.4];
    node [shape=box, style="rounded,filled", fillcolor="#eff6ff",
          color="#475569", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
    edge [color="#475569", fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];

    metadata [label="Public metadata from flow 1\nItem table, asset lock, Collection metadata", fillcolor="#f0fdf4"];
    package [label="stacpkg: build metadata package\nImage bytes stay in object storage"];
    registry [label="Push to workspace OCI registry\nResolve and verify package digest"];
    subgraph cluster_api {
        label="Second STAC API in the session vCluster";
        fontname="DejaVu Sans";
        color="#94a3b8";
        style="rounded,dashed";
        init [label="Init container: pull by digest\nRegistry credentials used only for the pull"];
        api [label="API: read local metadata\nSearch by area and date"];
        init -> api;
    }
    download [label="Returned asset links → PackageR HTTP API\nRedirect → object-storage download"];
    metadata -> package -> registry -> init;
    api -> download;
}
